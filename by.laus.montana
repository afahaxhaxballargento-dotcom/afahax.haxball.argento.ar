<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AFAHAX - Dominio Oficial de AFH</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        afablue: {
                            light: '#00d2ff',
                            DEFAULT: '#0088ff',
                            dark: '#0a1128',
                            navy: '#030b1e',
                            card: '#0d1838'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Teko', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&family=Teko:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #030b1e;
            color: #f1f5f9;
        }
        .font-display {
            font-family: 'Teko', sans-serif;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .glow-text {
            text-shadow: 0 0 12px rgba(0, 210, 255, 0.6);
        }
        .badge-gradient {
            background: linear-gradient(135deg, #00d2ff 0%, #0055ff 100%);
        }
        .glass-panel {
            background: rgba(13, 24, 56, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(0, 210, 255, 0.2);
        }
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #030b1e;
        }
        ::-webkit-scrollbar-thumb {
            background: #0088ff;
            border-radius: 4px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-afablue-light selection:text-afablue-navy">

    <!-- Top Bar Header -->
    <header class="sticky top-0 z-50 glass-panel border-b border-afablue-light/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('inicio')">
                    <div>
                        <h1 class="text-3xl font-display font-bold leading-none tracking-wider text-white">
                            AFA<span class="text-afablue-light glow-text">HAX</span>
                        </h1>
                        <p class="text-[10px] text-afablue-light/90 font-semibold tracking-wider flex items-center gap-1 uppercase">
                            <i class="fa-solid fa-crown text-yellow-400"></i> Liga & Copas Oficiales
                        </p>
                    </div>
                </div>

                <!-- Desktop Navigation -->
                <nav class="hidden md:flex space-x-1 lg:space-x-2 items-center">
                    <button onclick="switchTab('inicio')" id="nav-inicio" class="nav-btn px-3 py-2 rounded-lg text-sm font-semibold transition-all text-afablue-light bg-afablue-light/10 border border-afablue-light/30"><i class="fa-solid fa-house mr-1.5"></i> Inicio</button>
                    <button onclick="switchTab('posiciones')" id="nav-posiciones" class="nav-btn px-3 py-2 rounded-lg text-sm font-semibold transition-all text-gray-300 hover:text-white hover:bg-white/5"><i class="fa-solid fa-list-ol mr-1.5"></i> Posiciones</button>
                    <button onclick="switchTab('copas')" id="nav-copas" class="nav-btn px-3 py-2 rounded-lg text-sm font-semibold transition-all text-gray-300 hover:text-white hover:bg-white/5"><i class="fa-solid fa-trophy text-yellow-400 mr-1.5"></i> Copas AH / SH</button>
                    <button onclick="switchTab('fixture')" id="nav-fixture" class="nav-btn px-3 py-2 rounded-lg text-sm font-semibold transition-all text-gray-300 hover:text-white hover:bg-white/5"><i class="fa-solid fa-calendar-days mr-1.5"></i> Fixture</button>
                    <button onclick="switchTab('estadisticas')" id="nav-estadisticas" class="nav-btn px-3 py-2 rounded-lg text-sm font-semibold transition-all text-gray-300 hover:text-white hover:bg-white/5"><i class="fa-solid fa-star mr-1.5"></i> Líderes</button>
                    <button onclick="switchTab('sanciones')" id="nav-sanciones" class="nav-btn px-3 py-2 rounded-lg text-sm font-semibold transition-all text-gray-300 hover:text-white hover:bg-white/5"><i class="fa-solid fa-triangle-exclamation mr-1.5 text-red-400"></i> Sanciones</button>
                    <button onclick="switchTab('reglamento')" id="nav-reglamento" class="nav-btn px-3 py-2 rounded-lg text-sm font-semibold transition-all text-gray-300 hover:text-white hover:bg-white/5"><i class="fa-solid fa-book-bookmark mr-1.5"></i> Reglamento</button>
                    <button onclick="openAdminModal()" class="px-3 py-2 rounded-lg text-sm font-bold bg-amber-600 hover:bg-amber-500 text-white transition-all shadow-md flex items-center gap-1.5"><i class="fa-solid fa-lock text-xs"></i> Admin</button>
                </nav>

                <!-- Mobile Menu Button -->
                <div class="md:hidden flex items-center space-x-2">
                    <button onclick="openAdminModal()" class="px-2.5 py-1.5 rounded-lg text-xs font-bold bg-amber-600 text-white"><i class="fa-solid fa-lock"></i></button>
                    <button id="mobile-menu-btn" class="text-gray-300 hover:text-white p-2"><i class="fa-solid fa-bars text-2xl"></i></button>
                </div>
            </div>
        </div>

        <!-- Mobile Dropdown Menu -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-afablue-light/20 bg-afablue-dark/95 px-4 pt-2 pb-4 space-y-2">
            <button onclick="switchTab('inicio')" class="block w-full text-left px-3 py-2 rounded-md text-base font-medium text-white"><i class="fa-solid fa-house w-6"></i> Inicio</button>
            <button onclick="switchTab('posiciones')" class="block w-full text-left px-3 py-2 rounded-md text-base font-medium text-gray-300"><i class="fa-solid fa-list-ol w-6"></i> Posiciones</button>
            <button onclick="switchTab('copas')" class="block w-full text-left px-3 py-2 rounded-md text-base font-medium text-yellow-400"><i class="fa-solid fa-trophy w-6"></i> Copas AH & SH</button>
            <button onclick="switchTab('fixture')" class="block w-full text-left px-3 py-2 rounded-md text-base font-medium text-gray-300"><i class="fa-solid fa-calendar-days w-6"></i> Fixture</button>
            <button onclick="switchTab('estadisticas')" class="block w-full text-left px-3 py-2 rounded-md text-base font-medium text-gray-300"><i class="fa-solid fa-star w-6"></i> Goleadores y Asistencias</button>
            <button onclick="switchTab('sanciones')" class="block w-full text-left px-3 py-2 rounded-md text-base font-medium text-red-400"><i class="fa-solid fa-triangle-exclamation w-6"></i> Sanciones</button>
        </div>
    </header>

    <!-- Sub Header Banner -->
    <div class="bg-gradient-to-r from-afablue-navy via-afablue-card to-afablue-navy border-b border-afablue-light/15 py-3 px-4">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3">
            <div class="flex items-center space-x-2 text-center md:text-left">
                <span class="bg-afablue-light/20 text-afablue-light text-xs font-extrabold uppercase px-2.5 py-0.5 rounded border border-afablue-light/40">FRASE OFICIAL</span>
                <p class="font-display text-xl sm:text-2xl font-bold tracking-wider text-yellow-400 drop-shadow-[0_0_8px_rgba(250,204,21,0.5)]">
                    "EL UNICO Y E7ERNO ES D10S"
                </p>
            </div>

            <div class="flex items-center bg-black/50 p-1.5 rounded-xl border border-white/10 shadow-inner">
                <div class="flex space-x-1 mr-3">
                    <button onclick="setMode('x5')" id="mode-btn-x5" class="px-3 py-1 rounded-lg text-xs font-bold transition-all bg-afablue-light text-afablue-navy shadow-md">MODALIDAD 5v5</button>
                    <button onclick="setMode('x3')" id="mode-btn-x3" class="px-3 py-1 rounded-lg text-xs font-bold transition-all text-gray-400 hover:text-white">MODALIDAD 3v3</button>
                </div>
                <div class="h-4 w-px bg-white/20 mr-3"></div>
                <div class="flex space-x-1">
                    <button onclick="setDiv('div1')" id="div-btn-div1" class="px-3 py-1 rounded-lg text-xs font-bold transition-all bg-afablue text-white shadow-md">1ª DIVISIÓN</button>
                    <button onclick="setDiv('div2')" id="div-btn-div2" class="px-3 py-1 rounded-lg text-xs font-bold transition-all text-gray-400 hover:text-white">2ª DIVISIÓN</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

        <!-- ==================== INICIO TAB ==================== -->
        <section id="tab-inicio" class="space-y-8">
            <div class="relative overflow-hidden rounded-3xl glass-panel p-6 sm:p-10 border border-afablue-light/35">
                <div class="max-w-3xl">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-afablue-light/10 text-afablue-light border border-afablue-light/30 mb-4">
                        <span class="w-2.5 h-2.5 rounded-full bg-green-400 animate-pulse"></span> LIGAS / COMPETICIONES EN CURSO
                    </span>
                    <h2 class="text-4xl sm:text-6xl font-display font-extrabold tracking-tight text-white mb-2 leading-none">
                        BIENVENIDOS A <span class="text-transparent bg-clip-text bg-gradient-to-r from-afablue-light via-blue-400 to-afablue font-bold">AFAHAX</span>
                    </h2>
                    <p class="text-base sm:text-lg text-slate-300 mb-6">
                        La liga competitiva más prestigiosa de Haxball Argentina. Competencia de alto rendimiento en 5v5 y 3v3, Copa AH y Copa SH.
                    </p>
                    <div class="flex flex-wrap gap-3">
                        <button onclick="switchTab('posiciones')" class="badge-gradient text-afablue-navy font-bold px-6 py-3 rounded-xl shadow-lg"><i class="fa-solid fa-list-ol mr-2"></i> Posiciones Liga</button>
                        <button onclick="switchTab('copas')" class="bg-yellow-500/20 text-yellow-400 font-bold px-6 py-3 rounded-xl border border-yellow-500/40"><i class="fa-solid fa-trophy mr-2"></i> Ver Copas AH / SH</button>
                    </div>
                </div>
            </div>

            <!-- ENCUESTA GENERAL INTERACTIVA -->
            <div class="glass-panel p-6 rounded-3xl border border-afablue-light/40 bg-gradient-to-br from-afablue-card to-afablue-navy space-y-6">
                <div class="flex items-center justify-between border-b border-white/10 pb-4">
                    <h3 class="text-2xl font-display font-bold text-yellow-400 flex items-center gap-2">
                        <i class="fa-solid fa-square-poll-vertical"></i> ENCUESTA GENERAL AFAHAX: ¿QUIÉN ES EL CANDIDATO?
                    </h3>
                    <span class="text-xs text-afablue-light bg-afablue-light/10 px-3 py-1 rounded-full border border-afablue-light/30">Votaciones en vivo</span>
                </div>
                <div class="grid md:grid-cols-4 gap-4">
                    <div class="bg-black/40 p-4 rounded-2xl border border-white/10 space-y-3">
                        <h4 class="font-bold text-sm text-afablue-light">Liga 5v5 (x5)</h4>
                        <select id="poll-x5" class="w-full bg-afablue-navy text-white text-xs p-2 rounded-lg border border-white/25"><option>Boca Juniors Hax</option><option>River Plate Hax</option><option>Independiente Hax</option></select>
                        <button onclick="votePoll('x5')" class="w-full bg-afablue-light text-afablue-navy font-bold text-xs py-2 rounded-lg">Votar x5</button>
                        <div id="result-x5" class="text-xs text-gray-300 font-mono text-center">Votos: 0</div>
                    </div>
                    <div class="bg-black/40 p-4 rounded-2xl border border-white/10 space-y-3">
                        <h4 class="font-bold text-sm text-afablue-light">Liga 3v3 (x3)</h4>
                        <select id="poll-x3" class="w-full bg-afablue-navy text-white text-xs p-2 rounded-lg border border-white/25"><option>Cyber Kings 3v3</option><option>Maradona Skillers</option><option>Fast Ballers x3</option></select>
                        <button onclick="votePoll('x3')" class="w-full bg-afablue-light text-afablue-navy font-bold text-xs py-2 rounded-lg">Votar x3</button>
                        <div id="result-x3" class="text-xs text-gray-300 font-mono text-center">Votos: 0</div>
                    </div>
                    <div class="bg-black/40 p-4 rounded-2xl border border-white/10 space-y-3">
                        <h4 class="font-bold text-sm text-yellow-400">Copa AH</h4>
                        <select id="poll-ah" class="w-full bg-afablue-navy text-white text-xs p-2 rounded-lg border border-white/25"><option>Boca Juniors Hax</option><option>Lanús Hax</option><option>River Plate Hax</option></select>
                        <button onclick="votePoll('ah')" class="w-full bg-yellow-500 text-afablue-navy font-bold text-xs py-2 rounded-lg">Votar Copa AH</button>
                        <div id="result-ah" class="text-xs text-gray-300 font-mono text-center">Votos: 0</div>
                    </div>
                    <div class="bg-black/40 p-4 rounded-2xl border border-white/10 space-y-3">
                        <h4 class="font-bold text-sm text-afablue-light">Copa SH</h4>
                        <select id="poll-sh" class="w-full bg-afablue-navy text-white text-xs p-2 rounded-lg border border-white/25"><option>San Lorenzo Hax</option><option>Belgrano Hax</option><option>Vélez Sarsfield Hax</option></select>
                        <button onclick="votePoll('sh')" class="w-full bg-afablue-light text-afablue-navy font-bold text-xs py-2 rounded-lg">Votar Copa SH</button>
                        <div id="result-sh" class="text-xs text-gray-300 font-mono text-center">Votos: 0</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== POSICIONES TAB ==================== -->
        <section id="tab-posiciones" class="hidden space-y-6">
            <div class="flex justify-between items-center bg-afablue-card/60 p-4 rounded-2xl border border-afablue-light/20">
                <div>
                    <h2 class="text-2xl font-bold text-white"><i class="fa-solid fa-list-ol text-afablue-light mr-2"></i> Tabla de Posiciones</h2>
                    <p class="text-sm text-gray-400">Mostrando para: <span class="current-label text-afablue-light font-bold">x5 - 1ª División</span></p>
                </div>
            </div>
            <div class="glass-panel rounded-2xl overflow-hidden border border-afablue-light/20 shadow-xl">
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead class="text-xs uppercase bg-afablue-navy/90 text-afablue-light border-b border-afablue-light/20">
                            <tr>
                                <th class="py-3 px-4 text-center">Pos</th><th class="py-3 px-4">Equipo</th><th class="py-3 px-3 text-center">PJ</th><th class="py-3 px-3 text-center">PG</th><th class="py-3 px-3 text-center">PE</th><th class="py-3 px-3 text-center">PP</th><th class="py-3 px-3 text-center">GF</th><th class="py-3 px-3 text-center">GC</th><th class="py-3 px-3 text-center">DG</th><th class="py-3 px-4 text-center text-white font-black bg-afablue-light/10">PTS</th><th class="py-3 px-4 text-center">Clasificación</th>
                            </tr>
                        </thead>
                        <tbody id="full-standings-body" class="divide-y divide-white/5 font-medium"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ==================== COPAS TAB ==================== -->
        <section id="tab-copas" class="hidden space-y-10">
            <div class="bg-gradient-to-r from-afablue-card via-yellow-950/20 to-afablue-card p-6 rounded-2xl border border-yellow-500/30">
                <h2 class="text-3xl font-display font-bold text-yellow-400 flex items-center gap-2">
                    <i class="fa-solid fa-trophy"></i> TORNEOS DE COPAS OFICIALES (AH & SH)
                </h2>
                <p class="text-sm text-gray-300">Fase de Grupos, Fixture con horarios editables y cruces de Semifinales y Finales.</p>
            </div>

            <!-- COPA AH -->
            <div class="space-y-6">
                <div class="flex items-center gap-3 border-b border-yellow-500/30 pb-3">
                    <span class="px-3 py-1 bg-yellow-500/20 text-yellow-400 rounded-lg font-bold text-sm border border-yellow-500/40">PRINCIPAL</span>
                    <h3 class="text-2xl font-bold text-white">COPA AH - Grupos y PlayOffs</h3>
                </div>
                <div class="grid md:grid-cols-2 gap-6">
                    <div class="glass-panel p-5 rounded-2xl border border-yellow-500/30">
                        <h4 class="text-lg font-bold text-yellow-400 mb-3">Grupo A</h4>
                        <table class="w-full text-sm mb-4"><tbody id="copa-ah-grupo-a" class="divide-y divide-white/5"></tbody></table>
                    </div>
                    <div class="glass-panel p-5 rounded-2xl border border-yellow-500/30">
                        <h4 class="text-lg font-bold text-yellow-400 mb-3">Grupo B</h4>
                        <table class="w-full text-sm mb-4"><tbody id="copa-ah-grupo-b" class="divide-y divide-white/5"></tbody></table>
                    </div>
                </div>
                <div class="glass-panel p-5 rounded-2xl border border-yellow-500/30 space-y-4">
                    <h4 class="text-lg font-bold text-yellow-400"><i class="fa-solid fa-clock mr-2"></i> Fixture y Horarios Copa AH</h4>
                    <div id="copa-ah-fixture-list" class="grid sm:grid-cols-2 gap-3"></div>
                </div>
                <div class="grid md:grid-cols-2 gap-6">
                    <div class="glass-panel p-5 rounded-2xl border border-yellow-500/30">
                        <h4 class="text-lg font-bold text-yellow-400 mb-3"><i class="fa-solid fa-medal mr-2"></i> Semifinales Copa AH</h4>
                        <div id="copa-ah-semis" class="space-y-2 text-sm"></div>
                    </div>
                    <div class="glass-panel p-5 rounded-2xl border border-yellow-500/30 bg-yellow-950/20">
                        <h4 class="text-lg font-bold text-yellow-400 mb-3"><i class="fa-solid fa-crown mr-2"></i> Gran Final Copa AH</h4>
                        <div id="copa-ah-final" class="space-y-2 text-sm"></div>
                    </div>
                </div>
            </div>

            <!-- COPA SH -->
            <div class="space-y-6 pt-6 border-t border-white/10">
                <div class="flex items-center gap-3 border-b border-afablue-light/30 pb-3">
                    <span class="px-3 py-1 bg-afablue-light/20 text-afablue-light rounded-lg font-bold text-sm border border-afablue-light/40">SECUNDARIO</span>
                    <h3 class="text-2xl font-bold text-white">COPA SH - Grupos y PlayOffs</h3>
                </div>
                <div class="grid md:grid-cols-2 gap-6">
                    <div class="glass-panel p-5 rounded-2xl border border-afablue-light/30">
                        <h4 class="text-lg font-bold text-afablue-light mb-3">Grupo A</h4>
                        <table class="w-full text-sm mb-4"><tbody id="copa-sh-grupo-a" class="divide-y divide-white/5"></tbody></table>
                    </div>
                    <div class="glass-panel p-5 rounded-2xl border border-afablue-light/30">
                        <h4 class="text-lg font-bold text-afablue-light mb-3">Grupo B</h4>
                        <table class="w-full text-sm mb-4"><tbody id="copa-sh-grupo-b" class="divide-y divide-white/5"></tbody></table>
                    </div>
                </div>
                <div class="glass-panel p-5 rounded-2xl border border-afablue-light/30 space-y-4">
                    <h4 class="text-lg font-bold text-afablue-light"><i class="fa-solid fa-clock mr-2"></i> Fixture y Horarios Copa SH</h4>
                    <div id="copa-sh-fixture-list" class="grid sm:grid-cols-2 gap-3"></div>
                </div>
                <div class="grid md:grid-cols-2 gap-6">
                    <div class="glass-panel p-5 rounded-2xl border border-afablue-light/30">
                        <h4 class="text-lg font-bold text-afablue-light mb-3"><i class="fa-solid fa-medal mr-2"></i> Semifinales Copa SH</h4>
                        <div id="copa-sh-semis" class="space-y-2 text-sm"></div>
                    </div>
                    <div class="glass-panel p-5 rounded-2xl border border-afablue-light/30 bg-blue-950/20">
                        <h4 class="text-lg font-bold text-afablue-light mb-3"><i class="fa-solid fa-crown mr-2"></i> Gran Final Copa SH</h4>
                        <div id="copa-sh-final" class="space-y-2 text-sm"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== FIXTURE TAB ==================== -->
        <section id="tab-fixture" class="hidden space-y-6">
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4 bg-afablue-card/60 p-4 rounded-2xl border border-afablue-light/20">
                <div>
                    <h2 class="text-2xl font-bold text-white"><i class="fa-solid fa-calendar-days text-afablue-light mr-2"></i> Fixture de Liga (12 Fechas)</h2>
                    <p class="text-sm text-gray-400">Calendario para: <span class="current-label text-afablue-light font-bold">x5 - 1ª División</span></p>
                </div>
                <div class="flex items-center space-x-2">
                    <label for="matchday-select" class="text-xs font-semibold text-gray-300">Fecha:</label>
                    <select id="matchday-select" onchange="renderFixture()" class="bg-afablue-navy text-white text-sm font-semibold rounded-lg px-3 py-1.5 border border-afablue-light/30">
                        <option value="1">Fecha 1</option><option value="2">Fecha 2</option><option value="3" selected>Fecha 3</option>
                        <option value="4">Fecha 4</option><option value="5">Fecha 5</option><option value="6">Fecha 6</option>
                        <option value="7">Fecha 7</option><option value="8">Fecha 8</option><option value="9">Fecha 9</option>
                        <option value="10">Fecha 10</option><option value="11">Fecha 11</option><option value="12">Fecha 12</option>
                    </select>
                </div>
            </div>
            <div id="fixture-matches-container" class="grid gap-4 md:grid-cols-2"></div>
        </section>

        <!-- ==================== ESTADÍSTICAS TAB ==================== -->
        <section id="tab-estadisticas" class="hidden space-y-8">
            <div class="bg-afablue-card/60 p-4 rounded-2xl border border-afablue-light/20">
                <h2 class="text-2xl font-bold text-white"><i class="fa-solid fa-star text-afablue-light mr-2"></i> Máximos Goleadores y Asistidores</h2>
            </div>
            <div class="space-y-4">
                <h3 class="text-xl font-bold text-afablue-light">Estadísticas de Liga (<span class="current-label">x5 - 1ª Div</span>)</h3>
                <div class="grid md:grid-cols-2 gap-6">
                    <div class="glass-panel p-6 rounded-2xl border border-afablue-light/20">
                        <h4 class="font-bold text-white mb-4"><i class="fa-solid fa-futbol text-yellow-400 mr-2"></i> Goleadores Liga</h4>
