                        { rank: 5, name: "Belgrano Hax", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 6, name: "Godoy Cruz Hax", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 7, name: "Defensa y Justicia Hax", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 8, name: "Tigre Hax", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
