                    name: "x3 - 1ª División",
                    teams: [
                        { rank: 1, name: "Cyber Kings 3v3", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 2, name: "Maradona Skillers", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 3, name: "Fast Ballers x3", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 4, name: "Apex Gaming Hax", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 5, name: "Tiki Taka Team", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 6, name: "Vapor Hax Crew", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 7, name: "Wall Bouncers", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 8, name: "Pared y Gol 3v3", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 9, name: "Lag Master Esports", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 10, name: "Noobs United x3", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 }
                    ],
                    fixture: {},
                    scorers: [], assists: []
                },
                div2: {
                    name: "x3 - 2ª División",
                    teams: [
                        { rank: 1, name: "Promesas 3v3", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 2, name: "Rebotes Infinitos", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 3, name: "Sniper Circle", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 4, name: "El Potrero Hax", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 5, name: "Corner Tactical", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 6, name: "Red Devils 3v3", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 7, name: "Ghost Players", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 8, name: "La Gambeta 3v3", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 9, name: "Underdogs Hax", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 },
                        { rank: 10, name: "Zero Points", pj: 0, pg: 0, pe: 0, pp: 0, gf: 0, gc: 0, sanction: 0 }
                    ],
                    fixture: {},
                    scorers: [], assists: []
                }
            },
            copasData: {
                ah: {
                    name: "Copa AH",
                    fixtures: [
                        { match: "Boca Juniors Hax vs Independiente Hax", time: "22:00 HS", date: "Viernes", result: "2 - 1" }
                    ],
                    semis: ["Boca Juniors Hax vs Lanús Hax", "River Plate Hax vs Independiente Hax"],
                    final: ["?", "?"]
                },
                sh: {
                    name: "Copa SH",
                    fixtures: [
                        { match: "San Lorenzo Hax vs Vélez Sarsfield Hax", time: "21:00 HS", date: "Jueves", result: "1 - 1" }
                    ],
                    semis: ["San Lorenzo Hax vs Belgrano Hax", "Vélez Sarsfield Hax vs Godoy Cruz Hax"],
                    final: ["?", "?"]
                }
            },
            sancionesList: [],
            pollVotes: { x5: 12, x3: 8, ah: 15, sh: 9 }
        };

        let db = JSON.parse(localStorage.getItem('afahax_master_db')) || defaultDb;

        document.getElementById('mobile-menu-btn').addEventListener('click', () => {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        });

        function switchTab(tabId) {
            ['inicio', 'posiciones', 'copas', 'fixture', 'estadisticas', 'sanciones', 'reglamento'].forEach(tab => {
                const sec = document.getElementById(`tab-${tab}`);
                const btn = document.getElementById(`nav-${tab}`);
                if (tab === tabId) {
                    sec.classList.remove('hidden');
                    if (btn) btn.className = "nav-btn px-3 py-2 rounded-lg text-sm font-semibold transition-all text-afablue-light bg-afablue-light/10 border border-afablue-light/30";
                } else {
                    sec.classList.add('hidden');
                    if (btn) btn.className = "nav-btn px-3 py-2 rounded-lg text-sm font-semibold transition-all text-gray-300 hover:text-white hover:bg-white/5";
                }
            });
            document.getElementById('mobile-menu').classList.add('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function setMode(mode) {
            currentMode = mode;
            updateButtons();
            renderAll();
        }

        function setDiv(div) {
            currentDiv = div;
            updateButtons();
            renderAll();
        }

        function updateButtons() {
            document.getElementById('mode-btn-x5').className = currentMode === 'x5' ? "px-3 py-1 rounded-lg text-xs font-bold bg-afablue-light text-afablue-navy shadow-md" : "px-3 py-1 rounded-lg text-xs font-bold text-gray-400 hover:text-white";
            document.getElementById('mode-btn-x3').className = currentMode === 'x3' ? "px-3 py-1 rounded-lg text-xs font-bold bg-afablue-light text-afablue-navy shadow-md" : "px-3 py-1 rounded-lg text-xs font-bold text-gray-400 hover:text-white";
            document.getElementById('div-btn-div1').className = currentDiv === 'div1' ? "px-3 py-1 rounded-lg text-xs font-bold bg-afablue text-white shadow-md" : "px-3 py-1 rounded-lg text-xs font-bold text-gray-400 hover:text-white";
            document.getElementById('div-btn-div2').className = currentDiv === 'div2' ? "px-3 py-1 rounded-lg text-xs font-bold bg-afablue text-white shadow-md" : "px-3 py-1 rounded-lg text-xs font-bold text-gray-400 hover:text-white";

            const currentData = db[currentMode][currentDiv];
            document.querySelectorAll('.current-label').forEach(el => el.textContent = currentData.name);
            document.querySelectorAll('.current-mode-label').forEach(el => el.textContent = currentMode === 'x5' ? '5v5' : '3v3');
        }

        // MOTOR DE CÁLCULO AUTOMÁTICO DE POSICIONES
        function calculateStandings(divData) {
            divData.teams.forEach(t => {
                t.pj = 0; t.pg = 0; t.pe = 0; t.pp = 0; t.gf = 0; t.gc = 0;
            });

            if (divData.fixture) {
                for (let matchday in divData.fixture) {
                    divData.fixture[matchday].forEach(m => {
                        if (m.gh !== undefined && m.gh !== '' && m.gv !== undefined && m.gv !== '') {
                            let gh = parseInt(m.gh);
                            let gv = parseInt(m.gv);
                            let localTeam = divData.teams.find(t => t.name === m.local);
                            let visitorTeam = divData.teams.find(t => t.name === m.visitor);

                            if (localTeam && visitorTeam) {
                                localTeam.pj++; visitorTeam.pj++;
                                localTeam.gf += gh; localTeam.gc += gv;
                                visitorTeam.gf += gv; visitorTeam.gc += gh;

                                if (gh > gv) {
                                    localTeam.pg++; visitorTeam.pp++;
                                } else if (gh < gv) {
                                    visitorTeam.pg++; localTeam.pp++;
                                } else {
                                    localTeam.pe++; visitorTeam.pe++;
                                }
                            }
                        }
                    });
                }
            }

            divData.teams.sort((a,b) => {
                let ptsA = (a.pg * 3) + a.pe + (a.sanction || 0);
                let ptsB = (b.pg * 3) + b.pe + (b.sanction || 0);
                if(ptsB !== ptsA) return ptsB - ptsA;
                return (b.gf - b.gc) - (a.gf - a.gc);
            });
            divData.teams.forEach((t, i) => t.rank = i + 1);
        }

        function renderAll() {
            const data = db[currentMode][currentDiv];
            calculateStandings(data);

            renderStandings(data);
            renderCopas();
            renderFixture();
            renderStats(data);
            renderSanciones();
            renderPolls();
        }

        function renderStandings(data) {
            const tbody = document.getElementById('full-standings-body');
            tbody.innerHTML = '';
            data.teams.forEach((t, idx) => {
                const pts = (t.pg * 3) + t.pe + (t.sanction || 0);
                const dg = t.gf - t.gc;
                let rankClass = idx < 4 ? "border-l-4 border-yellow-400 bg-yellow-950/10" : (idx < 8 ? "border-l-4 border-afablue-light bg-afablue-light/10" : "border-l-4 border-rose-500/40");
                let zoneTag = idx < 4 ? `<span class="px-2 py-1 rounded text-xs font-bold bg-yellow-500/20 text-yellow-300 border border-yellow-500/40">Copa AH</span>` : (idx < 8 ? `<span class="px-2 py-1 rounded text-xs font-bold bg-afablue-light/20 text-afablue-light border border-afablue-light/40">Copa SH</span>` : `<span class="px-2 py-1 rounded text-xs font-bold text-gray-400">Sin Copa</span>`);

                const tr = document.createElement('tr');
                tr.className = `hover:bg-white/5 transition border-b border-white/5 ${rankClass}`;
                tr.innerHTML = `<td class="py-3 px-4 text-center font-bold">${t.rank}</td><td class="py-3 px-4 font-bold text-white">${t.name}</td><td class="py-3 px-3 text-center font-mono">${t.pj}</td><td class="py-3 px-3 text-center font-mono">${t.pg}</td><td class="py-3 px-3 text-center font-mono">${t.pe}</td><td class="py-3 px-3 text-center font-mono">${t.pp}</td><td class="py-3 px-3 text-center font-mono">${t.gf}</td><td class="py-3 px-3 text-center font-mono">${t.gc}</td><td class="py-3 px-3 text-center font-mono font-bold ${dg > 0 ? 'text-green-400' : (dg < 0 ? 'text-red-400' : '')}">${dg > 0 ? '+'+dg : dg}</td><td class="py-3 px-4 text-center text-lg font-black text-afablue-light bg-afablue-light/10 font-mono">${pts} ${t.sanction ? `<span class="text-[10px] text-red-400">(${t.sanction})</span>` : ''}</td><td class="py-3 px-4 text-center">${zoneTag}</td>`;
                tbody.appendChild(tr);
            });
        }

        function renderCopas() {
            const d1 = db[currentMode].div1.teams;
            const d2 = db[currentMode].div2.teams;
            
            const groupAH_A = [{ name: d1[0].name, pts: 6 }, { name: d2[1].name, pts: 3 }, { name: d1[2].name, pts: 3 }, { name: d2[3].name, pts: 0 }];
            const groupAH_B = [{ name: d2[0].name, pts: 6 }, { name: d1[1].name, pts: 4 }, { name: d2[2].name, pts: 1 }, { name: d1[3].name, pts: 0 }];
            populateCopaTable('copa-ah-grupo-a', groupAH_A, 'text-yellow-400');
            populateCopaTable('copa-ah-grupo-b', groupAH_B, 'text-yellow-400');

            const groupSH_A = [{ name: d1[4].name, pts: 6 }, { name: d2[5].name, pts: 3 }, { name: d1[6].name, pts: 1 }, { name: d2[7].name, pts: 1 }];
            const groupSH_B = [{ name: d2[4].name, pts: 6 }, { name: d1[5].name, pts: 4 }, { name: d2[6].name, pts: 1 }, { name: d1[7].name, pts: 0 }];
            populateCopaTable('copa-sh-grupo-a', groupSH_A, 'text-afablue-light');
            populateCopaTable('copa-sh-grupo-b', groupSH_B, 'text-afablue-light');

            renderCopaFixture('ah');
            renderCopaFixture('sh');

            document.getElementById('copa-ah-semis').innerHTML = `<div class="p-2 bg-black/40 rounded border border-yellow-500/30 flex justify-between"><span>${db.copasData.ah.semis[0]}</span><span class="text-yellow-400 font-bold">Semis</span></div><div class="p-2 bg-black/40 rounded border border-yellow-500/30 flex justify-between"><span>${db.copasData.ah.semis[1]}</span><span class="text-yellow-400 font-bold">Semis</span></div>`;
            document.getElementById('copa-ah-final').innerHTML = `<div class="p-3 bg-yellow-950/40 rounded-xl border border-yellow-500/50 text-center font-bold text-yellow-300 text-lg"><i class="fa-solid fa-crown mr-2"></i> ${db.copasData.ah.final[0]} vs ${db.copasData.ah.final[1]}</div>`;

            document.getElementById('copa-sh-semis').innerHTML = `<div class="p-2 bg-black/40 rounded border border-afablue-light/30 flex justify-between"><span>${db.copasData.sh.semis[0]}</span><span class="text-afablue-light font-bold">Semis</span></div><div class="p-2 bg-black/40 rounded border border-afablue-light/30 flex justify-between"><span>${db.copasData.sh.semis[1]}</span><span class="text-afablue-light font-bold">Semis</span></div>`;
            document.getElementById('copa-sh-final').innerHTML = `<div class="p-3 bg-blue-950/40 rounded-xl border border-afablue-light/50 text-center font-bold text-afablue-light text-lg"><i class="fa-solid fa-crown mr-2"></i> ${db.copasData.sh.final[0]} vs ${db.copasData.sh.final[1]}</div>`;
        }

        function populateCopaTable(id, list, color) {
            const tbody = document.getElementById(id);
            tbody.innerHTML = '';
            list.forEach((t, i) => {
                tbody.innerHTML += `<tr class="${i<2?'bg-white/5':''}"><td class="p-2 text-white">${i<2?'<i class="fa-solid fa-circle-check text-green-400 mr-1 text-xs"></i>':''}${t.name}</td><td class="p-2 text-center font-mono font-bold ${color}">${t.pts} PTS</td></tr>`;
            });
        }

        function renderCopaFixture(cupKey) {
            const container = document.getElementById(`copa-${cupKey}-fixture-list`);
            container.innerHTML = '';
            db.copasData[cupKey].fixtures.forEach(f => {
                container.innerHTML += `<div class="bg-black/40 p-3 rounded-xl border border-white/10 flex justify-between items-center text-xs"><div><span class="font-bold text-white block">${f.match}</span><span class="text-gray-400">${f.date} - ${f.time}</span></div><span class="px-2 py-1 bg-afablue-navy border border-afablue-light/30 rounded font-mono font-bold text-afablue-light">${f.result}</span></div>`;
            });
        }

        function renderFixture() {
            let matchday = document.getElementById('matchday-select').value;
            let container = document.getElementById('fixture-matches-container');
            container.innerHTML = '';
            let divData = db[currentMode][currentDiv];

            if (divData.fixture && divData.fixture[matchday] && divData.fixture[matchday].length > 0) {
                divData.fixture[matchday].forEach(m => {
                    let scoreText = (m.gh !== undefined && m.gv !== undefined && m.gh !== '' && m.gv !== '') ? `${m.gh} - ${m.gv}` : `vs`;
                    container.innerHTML += `<div class="glass-panel p-4 rounded-2xl border border-afablue-light/20 flex flex-col space-y-2"><div class="flex justify-between text-xs text-gray-400 border-b border-white/10 pb-1"><span>Fecha ${matchday} • ${m.date || 'Jornada'}</span><span class="text-green-400 font-bold">${m.time || '22:00 HS'}</span></div><div class="flex justify-between items-center py-1 font-bold"><span class="flex-1 text-right pr-2 text-white">${m.local}</span><span class="px-3 py-1 bg-afablue-navy border border-afablue-light/30 rounded-xl font-mono text-afablue-light">${scoreText}</span><span class="flex-1 text-left pl-2 text-white">${m.visitor}</span></div></div>`;
                });
            } else {
                container.innerHTML = `<div class="col-span-2 text-center py-8 text-gray-400 text-sm">No hay partidos cargados para esta fecha. Podés armarlos desde el panel de administración.</div>`;
            }
        }

        function renderStats(data) {
            document.getElementById('top-scorers-body').innerHTML = data.scorers.map((s,i)=>`<tr class="border-b border-white/5"><td class="py-2 px-3 font-bold text-white">#${i+1} ${s.player}</td><td class="py-2 px-3 text-gray-400 text-xs">${s.team}</td><td class="py-2 px-3 text-center font-bold text-yellow-400 font-mono">${s.goals} G</td></tr>`).join('') || '<tr><td colspan="3" class="text-center py-4 text-gray-500 text-xs">Sin goleadores cargados</td></tr>';
            document.getElementById('top-assists-body').innerHTML = data.assists.map((a,i)=>`<tr class="border-b border-white/5"><td class="py-2 px-3 font-bold text-white">#${i+1} ${a.player}</td><td class="py-2 px-3 text-gray-400 text-xs">${a.team}</td><td class="py-2 px-3 text-center font-bold text-afablue-light font-mono">${a.assists} A</td></tr>`).join('') || '<tr><td colspan="3" class="text-center py-4 text-gray-500 text-xs">Sin asistencias cargadas</td></tr>';
        }

        function renderSanciones() {
            const tbody = document.getElementById('sanciones-table-body');
            tbody.innerHTML = '';
            db.sancionesList.forEach(s => {
                tbody.innerHTML += `<tr class="border-b border-white/5"><td class="py-3 px-4 font-bold text-white">${s.team}</td><td class="py-3 px-4 text-gray-300 text-xs">${s.mod}</td><td class="py-3 px-4 text-center text-red-400 font-bold font-mono">${s.pts} PTS</td><td class="py-3 px-4 text-gray-300 text-xs">${s.reason}</td></tr>`;
            });
            if(db.sancionesList.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="text-center py-6 text-gray-400 text-xs">No hay sanciones registradas.</td></tr>`;
            }
        }

        function votePoll(type) {
            db.pollVotes[type]++;
            localStorage.setItem('afahax_master_db', JSON.stringify(db));
            renderPolls();
            alert('¡Voto registrado con éxito!');
        }

        function renderPolls() {
            document.getElementById('result-x5').textContent = `Votos totales: ${db.pollVotes.x5}`;
            document.getElementById('result-x3').textContent = `Votos totales: ${db.pollVotes.x3}`;
            document.getElementById('result-ah').textContent = `Votos totales: ${db.pollVotes.ah}`;
            document.getElementById('result-sh').textContent = `Votos totales: ${db.pollVotes.sh}`;
        }

        // --- EXPORTAR E IMPORTAR RESPALDOS ---
        function exportarRespaldo() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(db, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", "respaldo_afahax_" + new Date().toISOString().slice(0,10) + ".json");
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }

        function importarRespaldo(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    db = JSON.parse(e.target.result);
                    localStorage.setItem('afahax_master_db', JSON.stringify(db));
                    renderAll();
                    alert('¡Respaldo importado y restaurado con éxito!');
                } catch (err) {
                    alert('El archivo no es válido.');
                }
            };
            reader.readAsText(file);
        }

        // --- PANEL ADMIN ULTIMATE DINÁMICO ---
        function openAdminModal() { document.getElementById('admin-modal').classList.remove('hidden'); }
        function closeAdminModal() { document.getElementById('admin-modal').classList.add('hidden'); document.getElementById('admin-password').value = ''; }
        
        function verifyAdminPassword() {
            if (document.getElementById('admin-password').value === 'afahax2026') {
                closeAdminModal();
                document.getElementById('admin-panel').classList.remove('hidden');
                initAdminPanel();
            } else { alert('Contraseña incorrecta (afahax2026)'); }
        }

        function closeAdminPanel() {
            localStorage.setItem('afahax_master_db', JSON.stringify(db));
            document.getElementById('admin-panel').classList.add('hidden');
            renderAll();
        }

        function initAdminPanel() {
            let targetKey = document.getElementById('admin-target-div').value;
            let action = document.getElementById('admin-action-type').value;
            let container = document.getElementById('admin-dynamic-content');
            container.innerHTML = '';

            if (targetKey.startsWith('copa_')) {
                let cupKey = targetKey === 'copa_ah' ? 'ah' : 'sh';
                let cup = db.copasData[cupKey];
                let html = `<h4 class="font-bold text-yellow-400 text-sm mb-2">Administrar Fixture y Finalistas de ${cup.name}</h4>`;
                html += `<div class="space-y-3 bg-black/30 p-3 rounded-xl border border-white/10"><h5 class="text-xs font-bold text-afablue-light">Editar Partidos y Horarios:</h5>`;
                cup.fixtures.forEach((f, idx) => {
                    html += `<div class="grid sm:grid-cols-3 gap-2"><input type="text" id="cup-fix-match-${idx}" value="${f.match}" class="bg-afablue-navy border border-white/20 rounded p-1 text-xs text-white"><input type="text" id="cup-fix-time-${idx}" value="${f.time}" class="bg-afablue-navy border border-white/20 rounded p-1 text-xs text-white"><input type="text" id="cup-fix-res-${idx}" value="${f.result}" class="bg-afablue-navy border border-white/20 rounded p-1 text-xs text-white"></div>`;
                });
                html += `</div>`;
                html += `<div class="space-y-2 mt-3"><h5 class="text-xs font-bold text-yellow-400">Gran Final (Equipos):</h5><div class="grid sm:grid-cols-2 gap-2"><div><label class="text-[10px] text-gray-400">Finalista 1</label><input type="text" id="cup-final-0" value="${cup.final[0]}" class="w-full bg-afablue-navy border border-white/20 rounded p-1.5 text-xs text-white"></div><div><label class="text-[10px] text-gray-400">Finalista 2</label><input type="text" id="cup-final-1" value="${cup.final[1]}" class="w-full bg-afablue-navy border border-white/20 rounded p-1.5 text-xs text-white"></div></div></div>`;
                html += `<button onclick="saveCupData('${cupKey}')" class="mt-3 px-4 py-2 bg-yellow-500 text-afablue-navy font-bold rounded text-xs">Guardar Cambios de ${cup.name}</button>`;
                container.innerHTML = html;
            } else {
                let [m, d] = targetKey.split('_');
                let divData = db[m][d];

                if (action === 'teams') {
                    let html = `<h4 class="font-bold text-white text-sm mb-2">Editar Nombres de ${divData.name}</h4><div class="grid md:grid-cols-2 gap-2">`;
                    divData.teams.forEach((t, i) => {
                        html += `<div><label class="text-[10px] text-gray-400">${i+1}.</label><input type="text" id="adm-team-${i}" value="${t.name}" class="w-full bg-afablue-navy border border-white/20 rounded p-1.5 text-xs text-white"></div>`;
                    });
                    html += `</div><button onclick="saveLigaTeams('${m}','${d}')" class="mt-3 px-4 py-2 bg-afablue text-white font-bold rounded text-xs">Guardar Nombres</button>`;
                    container.innerHTML = html;
                } else {
                    let html = `<h4 class="font-bold text-white text-sm mb-2">Armar y Modificar Fixture de ${divData.name}</h4>`;
                    html += `<div class="flex items-center gap-2 mb-3"><label class="text-xs text-gray-300 font-bold">Seleccionar Fecha a Armar:</label><select id="adm-fixture-matchday" onchange="initAdminPanel()" class="bg-afablue-navy text-white text-xs p-1.5 rounded border border-white/25">`;
                    for(let f=1; f<=12; f++) {
                        html += `<option value="${f}">Fecha ${f}</option>`;
                    }
                    html += `</select></div>`;

                    let selMatchdayEl = document.getElementById('adm-fixture-matchday');
                    let selectedMd = selMatchdayEl ? selMatchdayEl.value : 3;

                    if(!divData.fixture) divData.fixture = {};
                    if(!divData.fixture[selectedMd]) {
                        divData.fixture[selectedMd] = [
                            { local: divData.teams[0].name, visitor: divData.teams[1].name, time: "22:00 HS", date: "Viernes", gh: "", gv: "" },
                            { local: divData.teams[2].name, visitor: divData.teams[3].name, time: "22:30 HS", date: "Viernes", gh: "", gv: "" }
                        ];
                    }

                    html += `<div id="matches-builder-container" class="space-y-3 bg-black/40 p-3 rounded-xl border border-white/10">`;
                    divData.fixture[selectedMd].forEach((m, idx) => {
                        html += generateMatchRow(divData.teams, idx, m);
                    });
                    html += `</div>`;
                    html += `<div class="flex gap-2 mt-3"><button onclick="addMatchRow('${m}','${d}', ${selectedMd})" class="px-3 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded text-xs"><i class="fa-solid fa-plus mr-1"></i> Agregar Partido a esta Fecha</button><button onclick="saveLigaFixture('${m}','${d}', ${selectedMd})" class="px-4 py-2 bg-green-600 hover:bg-green-500 text-white font-bold rounded text-xs"><i class="fa-solid fa-floppy-disk mr-1"></i> Guardar y Actualizar Tabla</button></div>`;
                    container.innerHTML = html;
                    
                    if(selMatchdayEl) selMatchdayEl.value = selectedMd;
                }
            }
        }

        function generateMatchRow(teamsList, idx, matchData) {
            let teamOptionsLocal = teamsList.map(t => `<option value="${t.name}" ${matchData.local === t.name ? 'selected' : ''}>${t.name}</option>`).join('');
            let teamOptionsVisitor = teamsList.map(t => `<option value="${t.name}" ${matchData.visitor === t.name ? 'selected' : ''}>${t.name}</option>`).join('');

            return `<div id="match-row-${idx}" class="grid grid-cols-1 sm:grid-cols-6 gap-2 items-center bg-afablue-navy/80 p-2.5 rounded-lg border border-white/10">
                <div class="sm:col-span-2"><label class="text-[9px] text-gray-400 block">LOCAL</label><select id="adm-fix-local-${idx}" class="w-full bg-afablue-card border border-white/20 rounded p-1 text-xs text-white">${teamOptionsLocal}</select></div>
                <div class="sm:col-span-2"><label class="text-[9px] text-gray-400 block">VISITANTE</label><select id="adm-fix-visitor-${idx}" class="w-full bg-afablue-card border border-white/20 rounded p-1 text-xs text-white">${teamOptionsVisitor}</select></div>
                <div><label class="text-[9px] text-gray-400 block">GOLES (L - V)</label><div class="flex gap-1 items-center"><input type="number" id="adm-fix-gh-${idx}" value="${matchData.gh !== undefined ? matchData.gh : ''}" class="w-10 bg-afablue-card border border-white/20 rounded p-1 text-xs text-center text-white"><span class="text-white">-</span><input type="number" id="adm-fix-gv-${idx}" value="${matchData.gv !== undefined ? matchData.gv : ''}" class="w-10 bg-afablue-card border border-white/20 rounded p-1 text-xs text-center text-white"></div></div>
                <div class="flex items-end gap-1"><div class="flex-grow"><label class="text-[9px] text-gray-400 block">HORA</label><input type="text" id="adm-fix-time-${idx}" value="${matchData.time || '22:00 HS'}" class="w-full bg-afablue-card border border-white/20 rounded p-1 text-xs text-white"></div><button onclick="removeMatchRow(${idx})" class="bg-red-600/80 hover:bg-red-500 text-white p-1.5 rounded text-xs mt-3"><i class="fa-solid fa-trash"></i></button></div>
            </div>`;
        }

        function addMatchRow(m, d, matchday) {
            let divData = db[m][d];
            if(!divData.fixture[matchday]) divData.fixture[matchday] = [];
            divData.fixture[matchday].push({ local: divData.teams[0].name, visitor: divData.teams[1].name, time: "22:00 HS", date: "Viernes", gh: "", gv: "" });
            initAdminPanel();
        }

        function removeMatchRow(idx) {
            let targetKey = document.getElementById('admin-target-div').value;
            let [m, d] = targetKey.split('_');
            let matchday = document.getElementById('adm-fixture-matchday').value;
            db[m][d].fixture[matchday].splice(idx, 1);
            initAdminPanel();
        }

        function saveLigaTeams(m, d) {
            for(let i=0; i<db[m][d].teams.length; i++) {
                let val = document.getElementById(`adm-team-${i}`).value;
                if(val) db[m][d].teams[i].name = val;
            }
            alert('¡Nombres de equipos guardados con éxito!');
            renderAll();
        }

        function saveLigaFixture(m, d, matchday) {
            let divData = db[m][d];
            let rows = document.querySelectorAll('[id^="match-row-"]');
            
            let updatedMatches = [];
            rows.forEach((row, idx) => {
                let l = document.getElementById(`adm-fix-local-${idx}`).value;
                let v = document.getElementById(`adm-fix-visitor-${idx}`).value;
                let gh = document.getElementById(`adm-fix-gh-${idx}`).value;
                let gv = document.getElementById(`adm-fix-gv-${idx}`).value;
                let time = document.getElementById(`adm-fix-time-${idx}`).value;

                updatedMatches.push({
                    local: l,
                    visitor: v,
                    gh: gh !== '' ? parseInt(gh) : '',
                    gv: gv !== '' ? parseInt(gv) : '',
                    time: time,
                    date: "Viernes"
                });
            });

            divData.fixture[matchday] = updatedMatches;
            localStorage.setItem('afahax_master_db', JSON.stringify(db));
            renderAll();
            alert('¡Fixture y resultados guardados! La tabla de posiciones se actualizó automáticamente.');
        }

        function saveCupData(cupKey) {
            let cup = db.copasData[cupKey];
            cup.fixtures.forEach((f, idx) => {
                let m = document.getElementById(`cup-fix-match-${idx}`).value;
                let t = document.getElementById(`cup-fix-time-${idx}`).value;
                let r = document.getElementById(`cup-fix-res-${idx}`).value;
                if(m) f.match = m;
                if(t) f.time = t;
                if(r) f.result = r;
            });
            cup.final[0] = document.getElementById('cup-final-0').value;
            cup.final[1] = document.getElementById('cup-final-1').value;
            alert('¡Copa actualizada con éxito!');
            renderAll();
        }

        function applySanction() {
            let team = document.getElementById('sanction-team-name').value;
            let pts = document.getElementById('sanction-points').value;
            db.sancionesList.push({ team: team, mod: `${currentMode.toUpperCase()} - ${currentDiv}`, pts: pts, reason: "Sanción reglamentaria" });
            localStorage.setItem('afahax_master_db', JSON.stringify(db));
            alert('¡Sanción aplicada correctamente!');
            renderAll();
        }

        function resetFactory() {
            if(confirm('¿Deseas reiniciar todos los valores de fábrica?')) {
                localStorage.removeItem('afahax_master_db');
                db = defaultDb;
                closeAdminPanel();
                renderAll();
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            updateButtons();
            renderAll();
        });
    </script>
</body>
</html>
